# Firebase web app config (Project settings > General > Your apps > Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin credential. Every Firestore read and write goes through the
# Admin SDK. Locally, point at the downloaded service-account file; on Vercel,
# paste the whole JSON into FIREBASE_SERVICE_ACCOUNT_JSON instead.
FIREBASE_SERVICE_ACCOUNT_PATH="./serviceAccountKey.json"
# FIREBASE_SERVICE_ACCOUNT_JSON=""

# Comma-separated @vit.edu.in addresses that are admins regardless of the role
# stored on their profile. This is how the first admin is bootstrapped.
ADMIN_EMAILS=""

# Optional: Gemini key for AI tag suggestions (https://aistudio.google.com/app/apikey)
GOOGLE_GENAI_API_KEY=""
